{
  "name": "omi-board-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "gen": "openapi-typescript ../api/openapi.yaml -o src/lib/api/schema.d.ts",
    "test": "node --experimental-strip-types --test src/lib/obs/*.test.mjs"
  },
  "dependencies": {
    "@sentry/browser": "10.78.0",
    "next": "16.4.5",
    "openapi-fetch": "0.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "openapi-typescript": "7.9.1",
    "typescript": "6.0.3"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
